# Supabase (Project Settings > API). A chave publishable é pública por desenho;
# a segurança vem do RLS no banco. Não use a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Pluggy (dashboard.pluggy.ai > Aplicação). Só no servidor: nunca com NEXT_PUBLIC_.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# opcional: botão de WhatsApp na confirmação do formulário (DDI+DDD+número, só dígitos)
NEXT_PUBLIC_WHATSAPP=
