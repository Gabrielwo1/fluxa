# Supabase (Project Settings > API). A chave publishable é pública por desenho;
# a segurança vem do RLS no banco. Não use a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Pluggy (dashboard.pluggy.ai > Aplicação). Só no servidor: nunca com NEXT_PUBLIC_.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Aplicação da Pluggy própria de um cliente (conta dele no Dashboard). Sufixo = slug em maiúsculas.
# Sem essas duas, o cliente usa a aplicação padrão acima.
# PLUGGY_CLIENT_ID_MOTTA=
# PLUGGY_CLIENT_SECRET_MOTTA=

# Modo local por cliente (só desenvolvimento): LOCAL_CLIENT=motta npm run dev:motta

# Acesso por código (SÓ no servidor; esta chave ignora o RLS: nunca com NEXT_PUBLIC_).
# Supabase > Project Settings > API > service_role (ou "secret").
SUPABASE_SERVICE_ROLE_KEY=
# Caixa de e-mail que você controla. Cada código vira um usuário "voce+fx-abcd@dominio.com".
ACCESS_EMAIL_BASE=voce@seudominio.com.br

# opcional: botão de WhatsApp na confirmação do formulário (DDI+DDD+número, só dígitos)
NEXT_PUBLIC_WHATSAPP=
